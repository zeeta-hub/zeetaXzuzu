<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zeeta Shop 🌸 VVIP Store</title>
    <style>
      :root {
        --bg-main: #0b090f;
        --bg-card: #15111d;
        --border-color: #2a223d;
        --accent-purple: #af50f6;
        --accent-blue: #7288f7;
        --text-main: #f3f0f7;
        --text-muted: #9e95b0;
        --success: #00ff66;
        --danger: #ff3366;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: var(--bg-main);
        color: var(--text-main);
        margin: 0;
        padding: 20px;
      }
      h1,
      h2 {
        color: var(--accent-purple);
        text-align: center;
      }
      .container {
        max-width: 1000px;
        margin: 0 auto;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-top: 20px;
      }
      .card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        padding: 15px;
        border-radius: 12px;
        text-align: center;
        transition: 0.2s;
        cursor: pointer;
      }
      .card:hover {
        border-color: var(--accent-purple);
        transform: translateY(-3px);
      }
      .card img {
        width: 100%;
        height: 140px;
        object-fit: cover;
        border-radius: 8px;
      }
      .price {
        color: var(--success);
        font-weight: bold;
        font-size: 18px;
        margin: 10px 0;
      }
      .btn {
        background: var(--accent-purple);
        color: white;
        border: none;
        padding: 10px 15px;
        cursor: pointer;
        border-radius: 8px;
        font-weight: bold;
        width: 100%;
        text-decoration: none;
        display: inline-block;
        box-sizing: border-box;
        transition: 0.2s;
      }
      .btn:hover {
        background: #9b3de3;
      }
      .admin-panel,
      .feature-box {
        background: var(--bg-card);
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 25px;
        border: 1px solid var(--border-color);
      }
      .admin-panel {
        border-color: var(--danger);
        display: none;
      }
      input,
      textarea,
      select {
        width: 100%;
        padding: 12px;
        margin: 6px 0 16px 0;
        background: #0b090f;
        border: 1px solid var(--border-color);
        color: var(--text-main);
        border-radius: 8px;
        box-sizing: border-box;
      }
      input:focus,
      textarea:focus,
      select:focus {
        border-color: var(--accent-purple);
        outline: none;
      }
      .modal {
        display: none;
        position: fixed;
        z-index: 10;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(5, 4, 8, 0.85);
        justify-content: center;
        align-items: center;
      }
      .modal-content {
        background: var(--bg-card);
        padding: 25px;
        border-radius: 12px;
        width: 90%;
        max-width: 400px;
        text-align: center;
        border: 1px solid var(--accent-purple);
      }
      .pay-box {
        background: #0b090f;
        padding: 14px;
        text-align: left;
        font-size: 13px;
        border-radius: 8px;
        margin-bottom: 15px;
        border-left: 3px solid #25d366;
      }

      /* USER AUTH NAVBAR STYLING */
      .user-auth-nav {
        display: flex;
        gap: 8px;
        align-items: center;
      }
      .user-auth-nav button {
        padding: 6px 12px;
        font-size: 14px;
        font-weight: bold;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.3s ease;
      }
      .btn-user-login {
        background-color: transparent;
        color: var(--text-main);
        border: 1px solid var(--border-color);
      }
      .btn-user-login:hover {
        border-color: var(--accent-purple);
        background-color: rgba(175, 80, 246, 0.1);
      }
      .btn-user-register {
        background-color: var(--accent-purple);
        color: #ffffff;
        border: none;
      }
      .btn-user-register:hover {
        background-color: #9b3de3;
      }

      /* GEAR DROPDOWN MENU */
      .gear-container {
        position: relative;
        display: inline-block;
      }
      .gear-btn {
        background: #1f182c;
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 6px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 16px;
        font-weight: bold;
      }
      .gear-btn:hover {
        border-color: var(--accent-purple);
      }
      .gear-dropdown {
        display: none;
        position: absolute;
        right: 0;
        background: var(--bg-card);
        min-width: 220px;
        box-shadow: 0px 10px 25px rgba(0, 0, 0, 0.6);
        z-index: 1;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        overflow: hidden;
      }
      .gear-dropdown button {
        color: var(--text-main);
        padding: 12px 16px;
        text-decoration: none;
        display: block;
        background: none;
        border: none;
        width: 100%;
        text-align: left;
        cursor: pointer;
        font-size: 13px;
        font-weight: bold;
        transition: 0.1s;
      }
      .gear-dropdown button:hover {
        background: var(--accent-purple);
        color: #fff;
      }
      .gear-container.active .gear-dropdown {
        display: block;
      }

      .section-view {
        display: none;
      }
      .section-view.active {
        display: block;
      }
      .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
      }
      .stat-card {
        background: #0b090f;
        padding: 15px;
        border-radius: 8px;
        text-align: center;
        border-left: 4px solid var(--success);
        border: 1px solid var(--border-color);
      }
      .vouch-card {
        background: #0b090f;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 10px;
        border-left: 3px solid #ffaa00;
        border: 1px solid var(--border-color);
        text-align: left;
      }

      /* JOKI ACCORDION STYLES */
      .joki-category {
        background: #0b090f;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        margin-bottom: 12px;
        overflow: hidden;
      }
      .joki-header {
        padding: 12px 15px;
        background: #191324;
        cursor: pointer;
        font-weight: bold;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--accent-purple);
      }
      .joki-header:hover {
        background: #221a32;
      }
      .joki-body {
        padding: 15px;
        display: none;
        border-top: 1px solid var(--border-color);
      }
      .joki-item-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px dashed var(--border-color);
        font-size: 14px;
      }
      .joki-item-row:last-child {
        border-bottom: none;
      }

      /* SECRET ADMIN TRIGGER STYLE */
      .secret-brand {
        cursor: pointer;
        user-select: none;
        transition: 0.2s;
        display: inline-block;
      }
      .secret-brand:active {
        transform: scale(0.97);
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div
        style="
          display: flex;
          justify-content: flex-end;
          align-items: center;
          margin-bottom: 15px;
          gap: 10px;
          flex-wrap: wrap;
        "
      >
        <span
          id="userInfoDisplay"
          style="color: var(--success); font-weight: bold; margin-right: auto"
        ></span>

        <!-- TOMBOL DAFTAR / LOGIN USER BIASA -->
        <div class="user-auth-nav" id="userAuthNavContainer">
          <button onclick="showUserAuthModal('login')" class="btn-user-login">
            Masuk
          </button>
          <button
            onclick="showUserAuthModal('register')"
            class="btn-user-register"
          >
            Daftar
          </button>
        </div>

        <!-- GEAR MENU ICON -->
        <div class="gear-container" id="gearMenuContainer">
          <button class="gear-btn" onclick="toggleGearMenu()">
            ⚙️ Menu Utama
          </button>
          <div class="gear-dropdown">
            <button onclick="switchTab('home', this)">
              🏠 Home (Semua Menu)
            </button>
            <button onclick="switchTab('store', this)">
              📦 Katalog Produk
            </button>
            <button onclick="switchTab('joki', this)">⚔️ Layanan Joki</button>
            <button onclick="switchTab('dashboard', this)">
              📊 Dashboard Toko
            </button>
            <button onclick="switchTab('taxcalc', this)">
              🧮 Kalkulator Pajak
            </button>
            <button onclick="switchTab('fruitlist', this)">
              🍎 Blox Fruits List
            </button>
            <button onclick="switchTab('vouch', this)">
              ⭐ Vouch & Reputasi
            </button>
          </div>
        </div>

        <button
          onclick="openCSModal()"
          style="
            background: #25d366;
            border: none;
            color: #fff;
            padding: 6px 12px;
            cursor: pointer;
            border-radius: 6px;
            font-weight: bold;
          "
        >
          Hubungi CS 💬
        </button>
        <button
          id="authNavBtn"
          onclick="openAuthModal()"
          style="
            background: none;
            border: 1px solid var(--success);
            color: var(--success);
            padding: 6px 12px;
            cursor: pointer;
            border-radius: 6px;
            font-weight: bold;
          "
        >
          🔑 Masuk Admin
        </button>
      </div>

      <!-- TOMBOL RAHASIA DI BAGIAN KIRI ATAS (KLIK 5 KALI) -->
      <div class="secret-brand" onclick="triggerSecretAdmin()">
        <h1>🌸 ZEETA SHOP 🌸</h1>
      </div>
      <p style="text-align: center; color: var(--text-muted); margin-top: -5px">
        ✨ Pusat Top Up Robux, Akun, Joki & Gamepass Terpercaya 🚀
      </p>

      <!-- NOTIFIKASI / INFO SERVER DISCORD RESMI -->
      <div
        style="
          background: var(--bg-card);
          border: 1px solid var(--accent-purple);
          padding: 15px;
          border-radius: 12px;
          margin-bottom: 25px;
          text-align: center;
        "
      >
        <h3 style="color: var(--accent-purple); margin-top: 0">
          🎮 GABUNG SERVER DISCORD RESMI KAMI!
        </h3>
        <p
          style="font-size: 13px; color: var(--text-muted); margin-bottom: 15px"
        >
          Nama <b>Zeeta</b> dulunya adalah <b>Zuzu</b>. Perubahan nama ini
          dikarenakan akun Discord yang lama terkena <i>banned</i> oleh pihak
          Discord.
        </p>
        <div
          style="
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
          "
        >
          <a
            href="https://discord.gg/AqDzv6C9cV"
            target="_blank"
            class="btn"
            style="
              background: #5865f2;
              flex: 1;
              min-width: 200px;
              text-decoration: none;
            "
          >
            🚀 ZeetaShop (Official Server)
          </a>
          <a
            href="https://discord.gg/Am3HvspbV6"
            target="_blank"
            class="btn"
            style="
              background: #7289da;
              flex: 1;
              min-width: 200px;
              text-decoration: none;
            "
          >
            ⭐ Zuzustore (Tempat Testimoni)
          </a>
        </div>
      </div>

      <!-- 0. HALAMAN HOME (MENAMPILKAN SEMUA BAGIAN) -->
      <div id="home-section" class="section-view active">
        <!-- Dashboard Mini -->
        <div class="feature-box">
          <h2>📊 DASHBOARD INFORMASI ZEETA SHOP</h2>
          <div class="dashboard-grid">
            <div class="stat-card">
              <h3>📦 Total Produk Utama</h3>
              <p
                id="statTotalProdHome"
                style="font-size: 22px; font-weight: bold; color: #fff"
              >
                0
              </p>
            </div>
            <div
              class="stat-card"
              style="border-left-color: var(--accent-blue)"
            >
              <h3>🛍️ Total Transaksi Sukses</h3>
              <p
                style="
                  font-size: 22px;
                  font-weight: bold;
                  color: var(--success);
                "
              >
                800+
              </p>
            </div>
            <div
              class="stat-card"
              style="border-left-color: var(--accent-purple)"
            >
              <h3>⚡ Status Toko</h3>
              <p
                style="
                  font-size: 18px;
                  font-weight: bold;
                  color: var(--success);
                "
              >
                🟢 ONLINE / BUKA
              </p>
            </div>
            <div class="stat-card" style="border-left-color: #ffaa00">
              <h3>⭐ Rating Toko</h3>
              <p style="font-size: 22px; font-weight: bold; color: #fff">
                ⭐ 5.0 / 5.0
              </p>
            </div>
          </div>
        </div>

        <!-- Katalog Produk -->
        <div class="admin-panel" id="adminPanelHome">
          <h2>🛠️ PANEL KELOLA PRODUK UTAMA</h2>
          <form id="addProductFormHome" onsubmit="addProduct(event)">
            <label>🏷️ Nama Produk:</label>
            <input type="text" id="prodNameHome" required />
            <label>💰 Harga (Rp):</label>
            <input type="number" id="prodPriceHome" required />
            <label>📝 Deskripsi:</label>
            <textarea id="prodDescHome" required></textarea>
            <label>🖼️ URL Foto Produk:</label>
            <input
              type="text"
              id="prodImageHome"
              placeholder="https://... (kosongkan untuk default)"
            />
            <button type="submit" class="btn">✨ Tambah Produk Baru</button>
          </form>
        </div>
        <h2>🔥 PRODUK TERSEDIA</h2>
        <div
          class="grid"
          id="productGridHome"
          style="margin-bottom: 30px"
        ></div>

        <!-- Menu Joki Section (Home) -->
        <div class="feature-box" style="margin-top: 30px">
          <h2>⚔️ LAYANAN JOKI TERPERCAYA</h2>
          <p
            style="
              color: var(--text-muted);
              text-align: center;
              font-size: 13px;
              margin-bottom: 20px;
            "
          >
            🎮 Pilih jenis joki di bawah ini sesuai kebutuhan game kamu:
          </p>

          <div
            style="
              display: flex;
              gap: 10px;
              margin-bottom: 20px;
              flex-wrap: wrap;
            "
          >
            <button
              class="btn"
              style="flex: 1; min-width: 200px"
              onclick="switchTab('joki', document.querySelector('.gear-dropdown button:nth-child(3)'))"
            >
              🍎 Buka Menu Joki Blox Fruits
            </button>
            <button
              class="btn"
              style="flex: 1; min-width: 200px; background: var(--accent-blue)"
              onclick="switchTab('joki', document.querySelector('.gear-dropdown button:nth-child(3)'))"
            >
              💤 Buka Menu Joki AFK
            </button>
          </div>
        </div>

        <!-- Blox Fruits List Section -->
        <div class="feature-box" style="margin-top: 30px">
          <h2>🍎 BLOX FRUITS LIST & STOK</h2>
          <div
            class="admin-panel"
            id="adminFruitPanelHome"
            style="display: none; margin-bottom: 20px"
          >
            <h3
              id="fruitFormTitleHome"
              style="color: var(--accent-purple); margin-top: 0"
            >
              ➕ Tambah Buah Baru
            </h3>
            <form id="addFruitFormHome" onsubmit="handleFruitForm(event)">
              <input type="hidden" id="editFruitIndexHome" value="-1" />
              <label>🍎 Nama Buah:</label>
              <input
                type="text"
                id="fruitNameHome"
                required
                placeholder="Contoh: Kitsune"
              />
              <label>💰 Harga (Rp / Info Harga):</label>
              <input
                type="text"
                id="fruitPriceHome"
                required
                placeholder="Contoh: Rp 120.000"
              />
              <label>📦 Stok:</label>
              <input
                type="text"
                id="fruitStockHome"
                required
                placeholder="Contoh: Tersedia (3)"
              />
              <label>📝 Deskripsi Detail:</label>
              <textarea
                id="fruitDescHome"
                required
                placeholder="Jelaskan detail buah..."
              ></textarea>
              <button type="submit" class="btn">💾 Simpan Buah</button>
              <button
                type="button"
                id="cancelFruitEditBtnHome"
                onclick="resetFruitForm()"
                class="btn"
                style="
                  background: var(--danger);
                  margin-top: 8px;
                  display: none;
                "
              >
                ❌ Batal Edit
              </button>
            </form>
          </div>
          <div
            class="grid"
            id="fruitGridContainerHome"
            style="margin-top: 15px"
          ></div>
        </div>

        <!-- Kalkulator Pajak Section -->
        <div class="feature-box" style="max-width: 500px; margin: 30px auto">
          <h2>🧮 KALKULATOR PAJAK ROBUX</h2>
          <label>⚙️ Pilih Mode Hitung:</label>
          <select id="taxModeHome" onchange="calculateTax()">
            <option value="receive">
              🔍 Cari tahu berapa Robux yang harus dijual
            </option>
            <option value="net">💰 Hitung bersih yang diterima</option>
          </select>
          <label>💎 Masukkan Nominal Robux:</label>
          <input
            type="number"
            id="taxInputHome"
            placeholder="Contoh: 500"
            oninput="calculateTax()"
          />
          <div
            style="
              background: #0b090f;
              padding: 15px;
              border-radius: 8px;
              margin-top: 15px;
              text-align: center;
              border: 1px solid var(--border-color);
            "
          >
            <p
              style="margin: 5px 0; color: var(--text-muted)"
              id="taxDescLabelHome"
            >
              📊 Hasil Perhitungan:
            </p>
            <h3
              id="resultTaxHome"
              style="color: var(--danger); font-size: 24px; margin: 0"
            >
              0 Robux
            </h3>
          </div>
        </div>

        <!-- Vouch & Reputasi Section -->
        <div class="feature-box" style="max-width: 600px; margin: 30px auto">
          <h2>⭐ TESTIMONI & VOUCH ZEETA SHOP</h2>
          <p
            style="
              text-align: center;
              color: var(--text-muted);
              font-size: 13px;
              margin-bottom: 15px;
            "
        
